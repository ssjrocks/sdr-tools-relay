[Unit]
Description=Public list of SDR Tools Relays (/api/sdr-relay/)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/sdr-relay-directory/relay_directory.py
Restart=always
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
CapabilityBoundingSet=
MemoryMax=128M

[Install]
WantedBy=multi-user.target
